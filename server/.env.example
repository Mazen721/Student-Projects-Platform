NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/spp_dev?replicaSet=rs0
JWT_SECRET=replace-with-at-least-32-chars-random-secret-key
JWT_REFRESH_SECRET=replace-with-another-32-chars-random-refresh-secret
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLIENT_URL=http://localhost:5173
SEARCH_PROVIDER=text
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
TZ_DISPLAY=Africa/Cairo
RATE_LIMIT_GLOBAL_MAX=300
SEED_ADMIN_EMAIL=admin@mnu.edu.eg
SEED_ADMIN_PASSWORD=ChangeMeNow!1
